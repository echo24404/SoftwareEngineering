<!DOCTYPE html>
<html lang="de">
<%- include('./common/head', { title: 'Registrieren', styles: [ '/public/css/signup.css', '/public/css/toggle.css', '/public/css/alertBox.css' ] }) %>
<body>
<%- include('./common/header', { showString: 'Login'})  %>
<main>
    <div class="background-image-container"></div>
    <section class="flex-box">
        <article class="flex-box-content">
            <h2>Registrierung</h2>
            <small class="info-user-input">* Pflichtfelder</small>
            <form id="signup-form">
                <label for="username">Benutzername*</label>
                <input type="text" id="username" name="username" required>
                <label for="password">Passwort*</label>
                <div class="toggle-container">
                    <input type="password" id="signup-password" name="password" required>
                    <span class="toggle-item" onclick="toggleVisibility('signup-password')">
                        <img id="toggle-icon" src="public/img/auth/iconPasswordHidden.png" alt="">
                    </span>
                </div>
                <div id="password-strength"></div>
                <label for="confirm-password">Passwort bestätigen*</label>
                <div class="toggle-container">
                    <input type="password" id="confirm-password" name="confirm-password" required>
                    <span class="toggle-item" onclick="toggleVisibility('confirm-password')">
                        <img id="toggle-icon" src="public/img/auth/iconPasswordHidden.png" alt="">
                    </span>
                </div>
                <label for="file-input">Profilbild hochladen</label>
                <%- include('./common/inputFile')  %>
                <button type="submit">Registrieren</button>
            </form>
            <p>Hast du schon ein Konto? <a class="underline" href="/login">Anmelden</a></p>
        </article>
    </section>
</main>
<%- include('./common/footer'); %>
<script src="/backend/controllers/toggleController.js"></script>
<script src="/backend/controllers/signupController.js"></script>
<script src="/backend/controllers/alertBoxController.js"></script>
<script src="/backend/models/signupModel.js"></script>
</body>
</html>
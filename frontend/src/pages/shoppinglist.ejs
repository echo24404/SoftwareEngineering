<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Einkaufsliste</title>
    <link rel="stylesheet" href="/css/shoppinglist.css">
</head>
<body>
<div class="container">
    <h1>Einkaufsliste</h1>
    <!-- Dropdown-Menü für Kategorien -->
    <div>
        <label for="category-select">Wähle Einkaufsliste:</label>
        <select id="category-select">
            <option value="">-- Auswahl --</option>
        </select>
        <button id="delete-category-btn">Liste löschen</button>
    </div>
    <!-- Formular zur Erstellung einer neuen Kategorie -->
    <div>
        <form id="add-category-form">
            <input type="text" id="new-category-name" placeholder="Neue Kategorie" required>
            <button type="submit">Kategorie hinzufügen</button>
        </form>
    </div>
</div>
<script src="/js/shoppinglist.js"></script>
</body>
</html>

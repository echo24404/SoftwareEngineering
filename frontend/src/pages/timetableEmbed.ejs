<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <title>Stundenplan einbinden</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f6f8;
            margin: 0;
            padding: 2rem;
            color: #333;
        }

        h1 {
            text-align: center;
            margin-bottom: 2rem;
        }

        form {
            max-width: 500px;
            margin: 0 auto 2rem;
            display: flex;
            gap: 1rem;
            justify-content: center;
        }

        input[type="url"] {
            flex: 1;
            padding: 0.5rem 0.75rem;
            border: 1px solid #ccc;
            border-radius: 6px;
            font-size: 1rem;
        }

        button {
            background-color: #0077cc;
            color: white;
            border: none;
            border-radius: 6px;
            padding: 0.5rem 1rem;
            font-size: 1rem;
            cursor: pointer;
            transition: background-color 0.2s ease;
        }

        button:hover {
            background-color: #005fa3;
        }

        h2 {
            text-align: center;
            margin-top: 3rem;
            color: #444;
        }

        iframe {
            display: block;
            margin: 1rem auto;
            border: 1px solid #ccc;
            width: 90%;
            height: 600px;
            border-radius: 8px;
        }
    </style>
</head>
<body>
<h1>Link zum Stundenplan</h1>

<form action="/timetable" method="POST">
    <input type="url" name="link" placeholder="https://..." required style="width: 300px;">
    <button type="submit">Anzeigen</button>
</form>

<% if (timetableUrl) { %>
    <h2>Vorschau:</h2>
    <iframe src="<%= timetableUrl %>" width="100%" height="600" style="border:1px solid #ccc;"></iframe>
<% } %>
</body>
</html>

<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Anmedlung</title>
    <link rel="stylesheet" href="../../public/css/login.css">
    <link rel="stylesheet" href="../../public/css/toggle.css">
    <link rel="stylesheet" href="../../public/css/alertBox.css">
</head><body>
<main>
    <div class="background-image-container"></div>
    <section class="flex-box">
        <article class="flex-box-content">
            <h2>Anmelden</h2>
            <small class="info-user-input">* Pflichtfelder</small>
            <form id="login-form">
                <p>
                    <label for="login-username">Benutzername*</label>
                    <input type="text" id="login-username" name="username" required>
                </p>
                <label for="login-password">Passwort*</label>
                <div class="toggle-container">
                    <input type="password" id="login-password" name="password" required>
                    <span class="toggle-item" onclick="toggleVisibility('login-password')">
                        <img id="toggle-icon" src="/assets/img/auth/iconPasswordHidden.png" alt="">
                    </span>
                </div>
                <button type="submit">Anmelden</button>
            </form>
            <p>Noch kein Konto? <a href="/signup">Jetzt registrieren</a></p>
        </article>
    </section>
</main>
<script src="../../controllers/toggleController.js"></script>
<script src="../../controllers/loginController.js"></script>
<script src="../../controllers/alertBoxController.js"></script>
<script src="../../../backend/models/loginModel.js"></script>
</body>
</html>
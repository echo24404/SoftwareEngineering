<!DOCTYPE html>
<html>
<head>
    <title><%= calendar.name %> – Kalender</title>
</head>
<body>
<h1>🗓️ <%= calendar.name %></h1>

<p><strong>Besitzer:</strong> <%= owner.name %></p>

<% if (sharedWith.length > 0) { %>
    <p><strong>Geteilt mit:</strong> <%= sharedWith.map(u => u.name).join(', ') %></p>
<% } else { %>
    <p><em>Privater Kalender</em></p>
<% } %>

<h2>Termine</h2>
<% if (calendar.events.length > 0) { %>
    <ul>
        <% calendar.events.forEach(event => { %>
            <li><strong><%= event.date %></strong>: <%= event.title %></li>
        <% }) %>
    </ul>
<% } else { %>
    <p>Keine Termine vorhanden.</p>
<% } %>

<a href="/my-calendars/<%= owner.id %>">← Zurück zur Übersicht</a>

<h2>📝 Neuen Termin hinzufügen</h2>
<form action="/calendar/<%= owner.id %>/<%= calendar.id %>/add-event" method="POST">
    <label>Datum:</label>
    <input type="date" name="date" required><br>

    <label>Titel:</label>
    <input type="text" name="title" required><br><br>

    <button type="submit">+ Termin hinzufügen</button>
</form>

</body>
</html>


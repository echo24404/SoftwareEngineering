<header class="main-header">
    <div class="top-bar">
        <div class="logo">

            <img src="/img/logo.png" alt="WG-App Logo" />
            <span class="brand-name">WG-App</span>
        </div>
        <div class="slogan">
            <p>Dein digitaler Begleiter für ein organisiertes WG-Leben</p>
        </div>
    </div>
    <nav class="main-nav">
        <ul>
            <% if (currentPage !== 'homepage') { %>
                <li><a href="/homepage">Home</a></li>
            <% } %>
            <% if (currentPage !== 'calendar') { %>
                <li><a href="/calendar">Kalender</a></li>
            <% } %>
            <% if (currentPage !== 'timetable') { %>
                <li><a href="/timetable">Stundenplan</a></li>
            <% } %>
            <% if (currentPage !== 'task') { %>
                <li><a href="/task">Aufgaben</a></li>
            <% } %>
            <% if (currentPage !== 'shoppingList') { %>
                <li><a href="/shoppingList">Einkaufsliste</a></li>
            <% } %>
        </ul>
    </nav>
</header>
